# SERVER ONLY. Never put secrets in VITE_ variables or commit a populated .env.
PORT=8787
SESSION_SECRET=
# Judges' reasoning: exactly one route. claude | lovable
REASONING_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Lovable AI route (docs/LOVABLE_AI_SETUP.md): the edge function URL, a shared secret you choose, and a gateway model id
LOVABLE_REASONING_URL=
LOVABLE_FUNCTION_SECRET=
LOVABLE_REASONING_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_NARRATOR_VOICE_ID=
ELEVENLABS_ADA_VOICE_ID=
ELEVENLABS_TUNDE_VOICE_ID=
ELEVENLABS_ZAINAB_VOICE_ID=
# Real audio-capable delivery assessor: "gemini" (audio input) or "human" (facilitator review).
DELIVERY_ASSESSOR_PROVIDER=
DELIVERY_ASSESSOR_MODEL=
GEMINI_API_KEY=
# Set by institution. Blank is not a valid production policy.
RECORDING_RETENTION_DAYS=
RECORDING_POLICY_VERSION=
SUPPORT_URL=
REVIEW_QUEUE_ENABLED=false
ALLOW_RECORDING_DOWNLOAD=true
# Enables /facilitator (human delivery review, overrides, audit).
FACILITATOR_TOKEN=
