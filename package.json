{
  "name": "the-floor-is-yours",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --port 5173 --strictPort",
    "dev:api": "PORT=8787 tsx watch --env-file-if-exists=.env.server server/index.ts",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e/run.mjs",
    "audio:audition": "tsx --env-file-if-exists=.env.server scripts/audio/audition-voices.ts",
    "audio:generate": "tsx --env-file-if-exists=.env.server scripts/audio/generate-static-audio.ts"
  },
  "dependencies": {
    "@fontsource/afacad": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.119.0",
    "motion": "^14.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "shadcn": "^4.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "engines": {
    "node": ">=22"
  }
}
