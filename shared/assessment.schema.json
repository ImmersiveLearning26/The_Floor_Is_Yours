{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FloorIsYoursModelJudgement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "needsReview",
    "reviewReason",
    "ratings",
    "strength",
    "improvement",
    "turns"
  ],
  "properties": {
    "needsReview": {
      "type": "boolean"
    },
    "reviewReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "ratings": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "level",
          "evidence",
          "justification"
        ],
        "properties": {
          "id": {
            "enum": [
              "position",
              "reasoning",
              "structure",
              "delivery"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "justification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "quote",
                "observation",
                "source"
              ],
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 60
                },
                "end": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 60
                },
                "quote": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "observation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "source": {
                  "enum": [
                    "transcript",
                    "audio"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "strength": {
      "type": "string",
      "maxLength": 400
    },
    "improvement": {
      "type": "string",
      "maxLength": 400
    },
    "turns": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "judgeId",
          "text"
        ],
        "properties": {
          "judgeId": {
            "enum": [
              "ada",
              "tunde",
              "zainab"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    }
  }
}
